+    # When an explicit (already gender-weighted) speaker pool is supplied,
+    # draw speaker pairs by independent weighted random sampling from it.
+    # This honours the weighting and avoids it.product()'s degenerate
+    # pairing, where speaker_1 advances only ~max_samples/num_speakers times
+    # over a whole run, so a single speaker dominates every SLERP blend.
+    if speaker_ids:
+        _spk_rng = random.Random(speaker_seed)
+        _spk_pool = list(speaker_ids)
+        def _speaker_pairs():
+            while True:
+                yield (_spk_rng.choice(_spk_pool), _spk_rng.choice(_spk_pool))
+        speakers_iter = _speaker_pairs()
+    else:
+        speakers_iter = it.cycle(it.product(range(num_speakers), range(num_speakers)))
